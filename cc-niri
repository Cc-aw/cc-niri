#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ID=cc-niri-maximize
EFFECT_ID=cc-niri-maximize-scroll-transition
CLIP_ID=cc-niri-viewport-clip
RING_ID=cc-niri-focus-ring
RING_GROUP=CCNiriFocusRing
RING_PATH="${HOME}/.local/lib64/qt6/plugins/kwin/effects/plugins/${RING_ID}.so"
SERVICE=cc-niri-bridge.service
LEGACY_SERVICE=cc-scroll-dock-bridge.service
COMPAT_GROUP=CCNiriCompatibility
INSTALLED_MAIN="${XDG_DATA_HOME:-${HOME}/.local/share}/kwin/scripts/${PLUGIN_ID}/contents/code/main.js"

usage() { echo 'Usage: cc-niri {start|stop|restart|status|help} | focus-ring {on|off|status} | workspace {primary|global|status}'; }
fail() { echo "cc-niri: $*" >&2; exit 1; }
kwin() { local path="$1" method="$2"; shift 2; gdbus call --session --dest org.kde.KWin --object-path "$path" --method "$method" "$@"; }
script_loaded() {
    local reply
    reply="$(kwin /Scripting org.kde.kwin.Scripting.isScriptLoaded "$PLUGIN_ID")" || fail "Cannot query KWin; no components were unloaded."
    [[ "$reply" == '(true,)' ]]
}
enable_plugin() { kwriteconfig6 --file kwinrc --group Plugins --key "${1}Enabled" --type bool "$2"; }
shortcut() {
    local names
    names="$(gdbus call --session --dest org.kde.kglobalaccel --object-path /component/kwin --method org.kde.kglobalaccel.Component.shortcutNames)" || return 1
    [[ "$names" == *"'$1'"* ]] || return 1
    gdbus call --session --dest org.kde.kglobalaccel --object-path /component/kwin --method org.kde.kglobalaccel.Component.invokeShortcut "$1";
}

restore_parked_windows() {
    # Recovery must execute in the old runtime while all WindowState ownership
    # still exists, before unloading either the script, effects, or Bridge.
    local reply
    if ! shortcut CCScrollEmergencyRestore >/dev/null 2>&1; then
        reply="$(gdbus call --session --dest org.cc.CCNiriBridge --object-path /CCNiriBridge \
            --method org.cc.CCNiriBridge1.RequestEmergencyRestore 2>/dev/null || true)"
        if [[ "$reply" != '(true,)' ]]; then
            reply="$(gdbus call --session --dest org.cc.ScrollDockBridge --object-path /ScrollDock \
                --method org.cc.ScrollDockBridge1.RequestEmergencyRestore 2>/dev/null || true)"
        fi
        [[ "$reply" == '(true,)' ]] || fail 'Cannot request window recovery; keeping the script loaded.'
        shortcut CCScrollApplyRuntimeCommand >/dev/null ||
            shortcut CCScrollApplyDockCommand >/dev/null ||
            fail 'Cannot invoke window recovery; keeping the script loaded.'
    fi
    sleep 0.3
}

compatibility() {
    local mode="$1" effect key
    while read -r effect key; do
        if [[ "$mode" == start ]]; then
            if [[ "$(kreadconfig6 --file kwinrc --group Plugins --key "${effect}Enabled" --default false)" == true ]]; then
                kwriteconfig6 --file kwinrc --group "$COMPAT_GROUP" --key "$key" --type bool true
            fi
            enable_plugin "$effect" false
            kwin /Effects org.kde.kwin.Effects.unloadEffect "$effect" >/dev/null
        elif [[ "$(kreadconfig6 --file kwinrc --group "$COMPAT_GROUP" --key "$key" --default false)" == true ]]; then
            enable_plugin "$effect" true
            kwin /Effects org.kde.kwin.Effects.loadEffect "$effect" >/dev/null
        fi
    done <<'EFFECTS'
kwin4_effect_geometry_change GeometryChangeWasEnabled
squash SquashWasEnabled
magiclamp MagicLampWasEnabled
EFFECTS
    workspace_animation_compatibility "$mode"
}

workspace_animation_compatibility() {
    local previous
    if [[ "$1" == start ]]; then
        [[ "$(kreadconfig6 --file kwinrc --group "Effect-${CLIP_ID}" --key OptimizedWorkspaceAnimation --default false)" == true ]] || return 0
        # Slide is enabled by default in KWin. Save the preference once, including
        # an explicit false, so restarting cc-niri never captures its own override.
        previous="$(kreadconfig6 --file kwinrc --group "$COMPAT_GROUP" --key SlideWasEnabled --default unset)"
        if [[ "$previous" == unset ]]; then
            previous="$(kreadconfig6 --file kwinrc --group Plugins --key slideEnabled --default true)"
            kwriteconfig6 --file kwinrc --group "$COMPAT_GROUP" --key SlideWasEnabled --type bool "$previous"
        fi
        enable_plugin slide false
        kwin /Effects org.kde.kwin.Effects.unloadEffect slide >/dev/null
    else
        previous="$(kreadconfig6 --file kwinrc --group "$COMPAT_GROUP" --key SlideWasEnabled --default unset)"
        if [[ "$previous" == true || "$previous" == false ]]; then
            enable_plugin slide "$previous"
            if [[ "$previous" == true ]]; then kwin /Effects org.kde.kwin.Effects.loadEffect slide >/dev/null; fi
            kwriteconfig6 --file kwinrc --group "$COMPAT_GROUP" --key SlideWasEnabled --delete
        fi
    fi
}

ring_status() {
    echo "Focus Ring preference: $(kreadconfig6 --file kwinrc --group "$RING_GROUP" --key EnabledByUser --default false)"
    echo "Focus Ring loaded: $(kwin /Effects org.kde.kwin.Effects.isEffectLoaded "$RING_ID")"
}

load_ring() {
    [[ -f "$RING_PATH" ]] || fail 'Focus Ring is not installed. Run ./install.sh first.'
    local reply
    reply="$(kwin /Effects org.kde.kwin.Effects.isEffectLoaded "$RING_ID")"
    if [[ "$reply" != '(true,)' ]]; then
        reply="$(kwin /Effects org.kde.kwin.Effects.loadEffect "$RING_ID")"
        [[ "$reply" == '(true,)' ]] || fail 'Unable to load Focus Ring; other components remain running.'
    fi
    enable_plugin "$RING_ID" true
}

focus_ring() {
    case "$1" in
        on)
            script_loaded || fail 'Start cc-niri before enabling Focus Ring.'
            load_ring
            kwriteconfig6 --file kwinrc --group "$RING_GROUP" --key EnabledByUser --type bool true
            echo 'Focus Ring enabled (static POC).'
            ;;
        off)
            enable_plugin "$RING_ID" false
            kwin /Effects org.kde.kwin.Effects.unloadEffect "$RING_ID" >/dev/null
            kwriteconfig6 --file kwinrc --group "$RING_GROUP" --key EnabledByUser --type bool false
            echo 'Focus Ring disabled; cc-niri continues running.'
            ;;
        status) ring_status ;;
    esac
}

workspace_mode() {
    local support mode previous attempt
    support="$(kwin /KWin org.kde.KWin.supportInformation)" || fail 'Cannot query KWin workspace support.'
    [[ "$support" =~ perOutputVirtualDesktops:\ (true|false) ]] ||
        fail 'This KWin does not support independent workspaces per output (KWin 6.7 is required).'
    previous="${BASH_REMATCH[1]}"
    if [[ "$1" == status ]]; then
        echo "Independent workspaces per output: $previous (Meta+J/K target the cc-niri primary screen)."
        return
    fi
    mode=false
    [[ "$1" != primary ]] || mode=true
    [[ "$previous" != "$mode" ]] || return 0
    kwriteconfig6 --file kwinrc --group Windows --key PerOutputVirtualDesktops --type bool "$mode"
    if ! kwin /KWin org.kde.KWin.reconfigure >/dev/null; then
        kwriteconfig6 --file kwinrc --group Windows --key PerOutputVirtualDesktops --type bool "$previous"
        fail 'Cannot apply workspace mode; restored the previous setting.'
    fi
    # KWin queues reconfigure on a timer; its D-Bus reply is not an apply ACK.
    for attempt in {1..20}; do
        support="$(kwin /KWin org.kde.KWin.supportInformation)" || break
        if [[ "$support" == *"perOutputVirtualDesktops: $mode"* ]]; then
            echo "Workspace switching: $1."
            return
        fi
        sleep 0.1
    done
    kwriteconfig6 --file kwinrc --group Windows --key PerOutputVirtualDesktops --type bool "$previous"
    kwin /KWin org.kde.KWin.reconfigure >/dev/null || true
    fail 'Cannot verify workspace mode; restored the previous setting.'
}

start_niri() {
    [[ -f "$INSTALLED_MAIN" ]] || fail 'Script is not installed. Run ./install.sh in the repository first.'
    if script_loaded; then
        if [[ "$(kreadconfig6 --file kwinrc --group "$RING_GROUP" --key EnabledByUser --default false)" == true ]]; then load_ring; fi
        echo 'cc-niri is already loaded. Use cc-niri restart to reload it.'
        return
    fi
    systemctl --user enable --now "$SERVICE" >/dev/null
    compatibility start
    # The layout script owns output selection; keep animation filtering aligned.
    local target_name
    target_name="$(kreadconfig6 --file kwinrc --group "Script-${PLUGIN_ID}" --key TargetOutputName --default "")"
    kwriteconfig6 --file kwinrc --group "Effect-${EFFECT_ID}" --key TargetOutputName "$target_name"
    enable_plugin "$CLIP_ID" true
    enable_plugin "$EFFECT_ID" true
    # Keep the script disabled during reconfigure to avoid an automatic load
    # racing with the explicit load/run below.
    enable_plugin "$PLUGIN_ID" false
    kwin /KWin org.kde.KWin.reconfigure >/dev/null
    local effect reply script_id
    for effect in "$CLIP_ID" "$EFFECT_ID"; do
        reply="$(kwin /Effects org.kde.kwin.Effects.loadEffect "$effect")"
        [[ "$reply" == '(true,)' ]] || fail "Unable to load effect: $effect"
    done
    # KWin's queued global reconfigure does not reread an already loaded effect's
    # settings. This synchronous API reparses kwinrc before applying Clip config.
    kwin /Effects org.kde.kwin.Effects.reconfigureEffect "$CLIP_ID" >/dev/null
    if [[ "$(kreadconfig6 --file kwinrc --group "Effect-${CLIP_ID}" --key OptimizedWorkspaceAnimation --default false)" == true ]]; then
        local native_status
        native_status="$(kwin /ccNiriViewportMotion org.cc.NiriViewportMotion1.GetScrollMotionStatus 2>/dev/null || true)"
        if [[ "$native_status" != *'"workspaceAnimationEnabled":true'* ]]; then
            # An older / unsupported plugin must not leave KDE Slide disabled.
            for effect in "$EFFECT_ID" "$CLIP_ID"; do
                enable_plugin "$effect" false
                kwin /Effects org.kde.kwin.Effects.unloadEffect "$effect" >/dev/null
            done
            workspace_animation_compatibility stop
            fail 'Native workspace animation did not enable; restored the Slide preference. Install the current Native Clip or disable OptimizedWorkspaceAnimation.'
        fi
    fi
    reply="$(kwin /Scripting org.kde.kwin.Scripting.loadScript "$INSTALLED_MAIN" "$PLUGIN_ID")"
    [[ "$reply" =~ ^\(([0-9]+),\)$ ]] || fail "Unable to load script: $reply"
    script_id="${BASH_REMATCH[1]}"
    kwin "/Scripting/Script${script_id}" org.kde.kwin.Script.run >/dev/null
    enable_plugin "$PLUGIN_ID" true
    script_loaded || fail 'KWin did not keep the script loaded.'
    if [[ "$(kreadconfig6 --file kwinrc --group "$RING_GROUP" --key EnabledByUser --default false)" == true ]]; then load_ring; fi
    echo 'cc-niri started. Meta+J: down; Meta+K: up.'
}

stop_niri() {
    if script_loaded; then restore_parked_windows; fi
    enable_plugin "$PLUGIN_ID" false
    enable_plugin "$EFFECT_ID" false
    enable_plugin "$CLIP_ID" false
    enable_plugin "$RING_ID" false
    kwin /Effects org.kde.kwin.Effects.unloadEffect "$RING_ID" >/dev/null
    if script_loaded; then
        [[ "$(kwin /Scripting org.kde.kwin.Scripting.unloadScript "$PLUGIN_ID")" == '(true,)' ]] || fail 'Unable to unload script.'
    fi
    kwin /Effects org.kde.kwin.Effects.unloadEffect "$EFFECT_ID" >/dev/null
    kwin /Effects org.kde.kwin.Effects.unloadEffect "$CLIP_ID" >/dev/null
    compatibility stop
    kwin /KWin org.kde.KWin.reconfigure >/dev/null
    systemctl --user disable --now "$SERVICE" >/dev/null 2>&1 || true
    systemctl --user disable --now "$LEGACY_SERVICE" >/dev/null 2>&1 || true
    echo 'cc-niri stopped; parked windows restored.'
}

status_niri() {
    local loaded=false enabled effect reply
    if script_loaded; then loaded=true; fi
    enabled="$(kreadconfig6 --file kwinrc --group Plugins --key "${PLUGIN_ID}Enabled" --default false)"
    echo "Script loaded: $loaded; enabled at login: $enabled"
    for effect in "$EFFECT_ID" "$CLIP_ID"; do
        reply="$(kwin /Effects org.kde.kwin.Effects.isEffectLoaded "$effect")"
        echo "$effect: $reply"
    done
    ring_status
    echo "Bridge: $(systemctl --user is-active "$SERVICE" || true)"
}

case "${1:-help}" in
    help|-h|--help) usage; exit 0 ;;
    focus-ring) [[ $# == 2 && "$2" =~ ^(on|off|status)$ ]] || { usage >&2; exit 2; } ;;
    workspace) [[ $# == 2 && "$2" =~ ^(primary|global|status)$ ]] || { usage >&2; exit 2; } ;;
    start|stop|restart|status) [[ $# == 1 ]] || { usage >&2; exit 2; } ;;
    *) usage >&2; exit 2 ;;
esac
for dependency in gdbus kwriteconfig6 kreadconfig6 systemctl; do
    command -v "$dependency" >/dev/null || fail "$dependency is required."
done
case "$1" in
    start) start_niri ;;
    stop) stop_niri ;;
    restart) stop_niri; start_niri ;;
    status) status_niri ;;
    focus-ring) focus_ring "$2" ;;
    workspace) workspace_mode "$2" ;;
esac
